{
  "name": "@etabs-bridge/mcp-server",
  "version": "0.2.0",
  "private": true,
  "description": "Model Context Protocol server exposing running ETABS models (via the ETABS Bridge plugin) to AI assistants.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "etabs-bridge-mcp": "./dist/main.js"
  },
  "scripts": {
