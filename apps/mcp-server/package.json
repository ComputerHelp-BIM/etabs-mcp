    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@etabs-bridge/client": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@etabs-bridge/mock-bridge": "0.2.0"
  }
}
