root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.sln]
end_of_line = crlf
indent_style = tab
